# syntax=docker/dockerfile:1.7         # Enable BuildKit features

################## Front-end ##################
FROM node:22.15.0-alpine AS frontend_builder

WORKDIR /frontend
ENV NODE_ENV=production

# ----- deps (cached) -----
COPY frontend/package*.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci --omit=dev

# ----- sources -----
COPY frontend/ .
RUN npm run build      # -> /frontend/dist

################## Back-end ##################
FROM golang:1.24.2-alpine AS backend_builder

WORKDIR /app
ENV CGO_ENABLED=0

# ----- deps (cached) -----
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download

# ----- sources & build -----
COPY . .
RUN --mount=type=cache,target=/root/.cache/go-build \
    go build -trimpath -ldflags="-s -w" -o main ./cmd/api

################## Runtime ##################
FROM alpine:latest AS prod

# add a non-root user
RUN addgroup -S app && adduser -S app -G app
WORKDIR /app

# copy artefacts only
COPY --from=backend_builder /app/main .
COPY --from=frontend_builder /frontend/dist ./dist

EXPOSE 8080
# HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
#   CMD wget --quiet --spider http://localhost:8080/health || exit 1

USER app:app
CMD ["./main"]
